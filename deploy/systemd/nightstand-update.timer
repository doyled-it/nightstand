[Unit]
Description=Run nightstand self-update every 15 minutes

[Timer]
# First run shortly after boot, then every 15 minutes. The random delay spreads
# the wake-ups so the update never lands at a fixed instant across machines.
OnBootSec=15min
OnUnitActiveSec=15min
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
